# Server Configuration
PORT=5000

# Database Configuration
# Use local MongoDB URI or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/secure_file_sharing

# JWT Configuration
# A strong, secret string used for signing JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_complex

# Token expiration time (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=7d

# Cryptography Configuration
# A 32-byte hex-encoded key for AES-256 encryption.
# It MUST be exactly 64 hex characters (0-9, a-f).
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
